# Copy to .env.local and fill in.

# Google OAuth credentials from Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional: override the OAuth redirect URI.
# Defaults to <request-origin>/api/auth/callback/google
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
